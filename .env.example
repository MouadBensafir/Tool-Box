# Shared secret Fusion must send back in the X-API-Key header on every
# request. Leave unset locally to skip auth; MUST be set in production.
SERVICE_API_KEY=

# Gmail OAuth credentials used to send the report emails directly from this
# service (same "Google Credentials" client_id/client_secret/refresh_token
# already used by Fusion's own Gmail node).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Railway sets this automatically; only needed for local runs.
PORT=3000
