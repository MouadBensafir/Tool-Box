# Shared secret Fusion must send back in the X-API-Key header on every
# request. Leave unset locally to skip auth; MUST be set in production.
SERVICE_API_KEY=

# Browserless.io token used for screenshot capture. Defaults to the same
# token already used by the Fusion workflow if left unset -- override here
# to rotate it without touching Fusion.
BROWSERLESS_TOKEN=

# Railway sets this automatically; only needed for local runs.
PORT=3000
